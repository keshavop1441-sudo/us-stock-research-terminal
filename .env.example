# Copy to .env and edit. .env is git-ignored. Do not put real secrets in this example file.
# No API keys are required for the current OpenBB providers (sec, nasdaq, cboe).

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Reasoning mode flags. If both are true, FAST_THINK wins.
FAST_THINK=false
DEEP_THINK=true

# --- Storage (optional) ---
# Relative paths are resolved against the project root.
# DATABASE_PATH=data/research.duckdb
